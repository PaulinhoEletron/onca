# Porta do host para o Postgres (a 5432 costuma estar ocupada por um Postgres local)
ONCA_DB_PORT=5433
DATABASE_URL=postgresql://onca:onca@localhost:5433/onca

# Provedor de LLM compatível com OpenAI (ainda não usado)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=changeme
LLM_MODEL=changeme

# Modelo local de embeddings (384 dimensões; baixado na primeira execução)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
